<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient mới: tím nhạt hiện đại -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F8F7FF"
                android:centerColor="#FAF8FF"
                android:endColor="#E8E6FF" />
        </shape>
    </item>
    
    <!-- Overlay loang 1 - góc trên trái (tím nhạt) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="700dp"
                android:startColor="#40E8E6FF"
                android:centerColor="#20E0DEFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Overlay loang 2 - góc dưới phải (tím nhạt) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="900dp"
                android:startColor="#40F0EEFF"
                android:centerColor="#20E8E6FF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Overlay loang 3 - giữa trái -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.5"
                android:gradientRadius="600dp"
                android:startColor="#30E8E6FF"
                android:centerColor="#15F0EEFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Overlay loang 4 - giữa phải -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.5"
                android:gradientRadius="650dp"
                android:startColor="#30FAF8FF"
                android:centerColor="#15E8E6FF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Overlay loang 5 - giữa trên -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.2"
                android:gradientRadius="1000dp"
                android:startColor="#30FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Overlay loang 6 - giữa dưới -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.8"
                android:gradientRadius="800dp"
                android:startColor="#20FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Dải loang chéo 1 - từ trên trái xuống dưới phải (tím) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#20E8E6FF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10F0EEFF" />
        </shape>
    </item>
    
    <!-- Dải loang chéo 2 - từ trên phải xuống dưới trái (tím) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#15FAF8FF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10E8E6FF" />
        </shape>
    </item>
    
    <!-- Dải loang ngang - từ trái sang phải -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#10E8E6FF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10F0EEFF" />
        </shape>
    </item>
    
    <!-- Dải loang dọc - từ trên xuống dưới -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#10FAF8FF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10E8E6FF" />
        </shape>
    </item>
    
    <!-- Dải loang dọc 2 - tạo độ sâu -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="#10FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
