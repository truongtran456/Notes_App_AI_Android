<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_height="match_parent"
  android:layout_width="match_parent"
  android:background="@drawable/bg_background"
  android:transitionName="@string/transition_note_card">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="45dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@null" >

        <!-- Hàng icon mới: back + undo + redo + draw + search + pin -->
        <include
            layout="@layout/toolbar_draw_edit" />

        <!-- Hàng search cũ, chỉ hiện khi startSearch() -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

            <EditText
              android:id="@+id/EnterSearchKeyword"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:background="@null"
              android:layout_weight="9"
              android:hint="@string/search"
              android:inputType="textFilter"
              android:paddingTop="10dp"
              android:paddingBottom="10dp"
              android:textAppearance="?attr/textAppearanceBody1"
              android:visibility="gone" />

            <TextView
              android:id="@+id/SearchResults"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@null"
              android:paddingTop="10dp"
              android:paddingBottom="10dp"
              android:paddingEnd="10dp"
              android:textIsSelectable="false"
              android:textAppearance="?attr/textAppearanceBody1"
              android:visibility="gone" />
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

        <!-- Canvas Full Screen Container - hiển thị khi mở drawing mode, nằm dưới toolbar -->
        <FrameLayout
            android:id="@+id/CanvasFullScreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@drawable/bg_background">
            
            <!-- Canvas full screen với background trắng, bo góc -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/CanvasFullScreenCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="0dp">
                
                <!-- Canvas view for drawing full screen -->
                <com.philkes.notallyx.draw.ui.newdraw.view.canvas.DrawingCanvasView
                    android:id="@+id/DrawingCanvasFullScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <com.philkes.notallyx.presentation.view.misc.NonScrollableNestedScrollView
            android:id="@+id/ScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:background="@drawable/bg_background"
          >

            <LinearLayout
                android:id="@+id/ContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:background="@android:color/transparent">

                <!-- Image Section: Full width, bo góc lớn -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ImageCardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/ImagePreviewPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:stateListAnimator="@null"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:visibility="visible"
                        app:chipIcon="@drawable/add_images"
                        app:chipStartPadding="8dp"
                        android:layout_gravity="top|end"
                        app:textStartPadding="2dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Title Section: Text to rõ đậm, có icon phía trước -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/TitleIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/pin"
                        android:tint="@color/app_primary"
                        android:contentDescription="@string/pin"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.philkes.notallyx.presentation.view.misc.StylableEditTextWithHistory
                        android:id="@+id/EnterTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="@string/title"
                        android:imeOptions="actionNext"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/TitleIcon"
                        app:layout_constraintEnd_toStartOf="@id/StatsIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Icon thống kê - chỉ hiển thị cho checklist -->
                    <ImageButton
                        android:id="@+id/StatsIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circular_button_ripple"
                        android:src="@drawable/ic_bar_chart"
                        android:contentDescription="@string/statistics"
                        android:visibility="gone"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Metadata: Text nhỏ mờ -->
                <TextView
                    android:id="@+id/Date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    android:textSize="12sp"
                    android:textColor="?android:textColorHint"
                    android:alpha="0.6"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp" />


                <!-- Files Preview: Card ngang/chip card -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/FilesPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <!-- Content Card: Nội dung trong card riêng, bo góc lớn, padding thoáng -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeWidth="0dp">

                    <com.philkes.notallyx.presentation.view.misc.StylableEditTextWithHistory
                        android:id="@+id/EnterBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:minHeight="48dp"
                        android:hint="@string/note"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:lineSpacingExtra="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Slide-to-Compare Summary View (full width, không margin, tự điều chỉnh chiều cao) -->
                <com.philkes.notallyx.presentation.view.ai.AiSlideCompareView
                    android:id="@+id/SlideCompareView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    android:visibility="gone" />

                <!-- Inline summary toolbar (preview/replace) - DEPRECATED, giữ lại để tương thích -->
                <include
                    android:id="@+id/InlineSummaryToolbarContainer"
                    layout="@layout/inline_summary_toolbar"
                    android:visibility="gone"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="end" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/RecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="4dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Canvas Preview Card: Preview với chiều cao cố định 140dp, click để mở full screen -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/CanvasCardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeWidth="0dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Canvas preview - chỉ hiển thị preview với chiều cao cố định -->
                        <ImageView
                            android:id="@+id/CanvasPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@android:color/white"
                            android:contentDescription="Canvas preview" />

                        <!-- Text "✏️ Canvas" góc trên trái -->
                        <TextView
                            android:id="@+id/CanvasLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️ Canvas"
                            android:textSize="12sp"
                            android:textColor="#6A5AE0"
                            android:layout_margin="12dp"
                            android:layout_gravity="top|start" />

                        <!-- Canvas view for drawing - ẩn đi, chỉ dùng khi mở full screen -->
                        <com.philkes.notallyx.draw.ui.newdraw.view.canvas.DrawingCanvasView
                            android:id="@+id/DrawingCanvas"
                            android:transitionName="shared_canvas"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/AddItem"
                    style="@style/TextView.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="@string/add_item"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?android:textColorHint"
                    android:textIsSelectable="false"
                    app:drawableStartCompat="@drawable/add" />

                <TextView
                    android:id="@+id/AudioHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="12dp"
                    android:text="@string/audio_recordings"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/AudioRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/LabelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

        </com.philkes.notallyx.presentation.view.misc.NonScrollableNestedScrollView>

    </LinearLayout>

    <!-- Bottom bar đã bị ẩn, thay bằng expandable FAB menu -->
    <com.google.android.material.bottomappbar.BottomAppBar
         android:id="@+id/BottomAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:backgroundTint="?attr/colorSurface"
        android:visibility="gone"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/BottomAppBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_8"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/BottomAppBarLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/BottomAppBarCenter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/BottomAppBarRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

    </com.google.android.material.bottomappbar.BottomAppBar>
    
    <!-- JellyFab ComposeView - Modern expandable FAB menu với jelly animation -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/JellyFabComposeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="16dp" />


    <!-- DrawToolPickerView - hiển thị cố định ở bottom -->
    <com.philkes.notallyx.draw.ui.newdraw.view.drawtool.DrawToolPickerView
        android:id="@+id/DrawToolPickerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Format Toolbar - hiển thị ở bottom khi format được chọn -->
    <include
        android:id="@+id/FormatToolbar"
        layout="@layout/format_toolbar"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>