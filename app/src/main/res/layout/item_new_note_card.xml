<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="2dp"
    app:strokeColor="#6D3FEF"
    android:backgroundTint="#EEEAFE"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/DottedCircle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_dotted_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/NewNoteText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <ImageView
            android:id="@+id/NewNoteIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/add"
            android:tint="#6D3FEF"
            app:layout_constraintTop_toTopOf="@id/DottedCircle"
            app:layout_constraintBottom_toBottomOf="@id/DottedCircle"
            app:layout_constraintStart_toStartOf="@id/DottedCircle"
            app:layout_constraintEnd_toEndOf="@id/DottedCircle" />

        <TextView
            android:id="@+id/NewNoteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New note"
            android:textColor="#6D3FEF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/DottedCircle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>



